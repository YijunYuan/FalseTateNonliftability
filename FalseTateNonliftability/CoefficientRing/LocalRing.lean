module

public import FalseTateNonliftability.CoefficientRing.Quotient
public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# The actual local structure of the completed coefficient ring

The canonical principal completion of Laurent series over a discrete valuation
ring is local. Its maximal ideal is generated by the original uniformizer,
and its actual residue field is the Laurent series field over the original
residue field. The uncompleted Laurent series ring need not be local.

This implements `nl:completed-coefficient-local-ring`.
-/

@[expose] public section

noncomputable section

namespace LaurentSeries

variable {O : Type*} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  (π : O) (hπ : Irreducible π)

include hπ

/-- The original constant-uniformizer ideal in the uncompleted Laurent ring
is maximal, because its actual coefficient quotient is a Laurent field. -/
theorem principalLaurentIdeal_isMaximal :
    (Ideal.span ({HahnSeries.C π} : Set (LaurentSeries O))).IsMaximal := by
  let : (Ideal.span ({π} : Set O)).IsMaximal := by
    rw [← hπ.maximalIdeal_eq]
    infer_instance
  let : Field (O ⧸ Ideal.span {π}) := Ideal.Quotient.field _
  simpa only [ker_principalReduction] using
    RingHom.ker_isMaximal_of_surjective (principalReduction π)
      (principalReduction_surjective π)

/-- The extended uniformizer ideal is maximal in the canonical completion. -/
theorem completedPrincipalIdeal_isMaximal :
    (Ideal.span {(algebraMap (LaurentSeries O) (PrincipalCompletion π)
      (HahnSeries.C π))}).IsMaximal := by
  let := principalLaurentIdeal_isMaximal π hπ
  have h := AdicCompletion.isMaximal_map_of_le
    (Ideal.span ({HahnSeries.C π} : Set (LaurentSeries O))) _ le_rfl
    (Submodule.fg_span_singleton _)
  simpa only [Ideal.map_span, Set.image_singleton] using h

/-- This is a local-ring structure on the actual principal completion. -/
theorem principalCompletion_isLocalRing : IsLocalRing (PrincipalCompletion π) := by
  let := completedPrincipalIdeal_isMaximal π hπ
  have h := AdicCompletion.isAdicComplete_self
    (Ideal.span ({HahnSeries.C π} : Set (LaurentSeries O)))
    (Submodule.fg_span_singleton _)
  let : IsAdicComplete
      (Ideal.span {(algebraMap (LaurentSeries O) (PrincipalCompletion π) (HahnSeries.C π))})
      (PrincipalCompletion π) := by
    simpa only [Ideal.map_span, Set.image_singleton] using h
  exact isLocalRing_of_isAdicComplete_maximal
    (Ideal.span {(algebraMap (LaurentSeries O) (PrincipalCompletion π) (HahnSeries.C π))})

/-- The actual maximal ideal is the ideal of the original constant uniformizer. -/
theorem principalCompletion_maximalIdeal :
    letI := principalCompletion_isLocalRing π hπ
    IsLocalRing.maximalIdeal (PrincipalCompletion π) =
      Ideal.span {(algebraMap (LaurentSeries O) (PrincipalCompletion π) (HahnSeries.C π))} := by
  let := principalCompletion_isLocalRing π hπ
  exact (IsLocalRing.eq_maximalIdeal (completedPrincipalIdeal_isMaximal π hπ)).symm

/-- Completeness holds for the actual maximal ideal of the same completion. -/
theorem principalCompletion_isAdicComplete :
    letI := principalCompletion_isLocalRing π hπ
    IsAdicComplete (IsLocalRing.maximalIdeal (PrincipalCompletion π))
      (PrincipalCompletion π) := by
  let := principalCompletion_isLocalRing π hπ
  rw [principalCompletion_maximalIdeal π hπ]
  simpa only [Ideal.map_span, Set.image_singleton] using
    AdicCompletion.isAdicComplete_self
      (Ideal.span ({HahnSeries.C π} : Set (LaurentSeries O)))
      (Submodule.fg_span_singleton _)

omit hπ in
/-- Coefficientwise transport along an actual ring equivalence. -/
def mapRingEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) : LaurentSeries R ≃+* LaurentSeries S :=
  RingEquiv.ofBijective (mapRingHom e.toRingHom) ⟨by
    intro f g h
    ext j
    apply e.injective
    exact congrArg (fun x : LaurentSeries S ↦ x.coeff j) h,
    mapRingHom_surjective e.toRingHom e.surjective⟩

omit hπ in
@[simp]
theorem mapRingEquiv_coeff {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (f : LaurentSeries R) (j : ℤ) :
    (mapRingEquiv e f).coeff j = e (f.coeff j) := rfl

/-- The actual residue field of the canonical completion, with the original
coefficient residue field, rather than an unrelated isomorphic field. -/
def principalCompletionResidueEquiv :
    letI := principalCompletion_isLocalRing π hπ
    IsLocalRing.ResidueField (PrincipalCompletion π) ≃+*
      LaurentSeries (IsLocalRing.ResidueField O) := by
  let := principalCompletion_isLocalRing π hπ
  have hA : IsLocalRing.maximalIdeal (PrincipalCompletion π) =
      Ideal.span {(algebraMap (LaurentSeries O) (PrincipalCompletion π) (HahnSeries.C π)) ^ 1} := by
    rw [pow_one, principalCompletion_maximalIdeal π hπ]
  have hO : Ideal.span ({π ^ 1} : Set O) = IsLocalRing.maximalIdeal O := by
    rw [pow_one, hπ.maximalIdeal_eq]
  exact (Ideal.quotEquivOfEq hA).trans
    ((completedPrincipalQuotientEquiv π 1).trans (mapRingEquiv (Ideal.quotEquivOfEq hO)))

/-- On original Laurent series the residue-field equivalence is exactly
coefficientwise reduction by the original residue map. -/
theorem principalCompletionResidueEquiv_residue_algebraMap_coeff
    (f : LaurentSeries O) (j : ℤ) :
    letI := principalCompletion_isLocalRing π hπ
    (principalCompletionResidueEquiv π hπ
      (IsLocalRing.residue (PrincipalCompletion π)
        (algebraMap (LaurentSeries O) (PrincipalCompletion π) f))).coeff j =
      IsLocalRing.residue O (f.coeff j) := by
  rfl

end LaurentSeries
