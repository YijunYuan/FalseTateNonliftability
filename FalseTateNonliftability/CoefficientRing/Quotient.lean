module

public import FalseTateNonliftability.LaurentSeries.PrincipalQuotient
public import Mathlib.RingTheory.AdicCompletion.Completeness

/-!
# Kernels of adic evaluation and of coefficient reduction

For a finitely generated ideal `I` of a commutative ring `R`, the kernel of the evaluation
`AdicCompletion I R → R ⧸ I ^ n` is the ideal of the completion generated by `I ^ n`.
For a principal ideal `J` of `R`, a Laurent series over `R` lies in the ideal `J R((T))` if and
only if all its coefficients lie in `J`; equivalently, `J R((T))` is the kernel of coefficientwise
reduction `R((T)) → (R ⧸ J)((T))`.

## Main results

* `AdicCompletion.ker_evalₐ_eq_map_pow`: `ker (AdicCompletion I R → R ⧸ I ^ n) = I ^ n Î`.
* `LaurentSeries.ker_mapRingHom_mk`: `ker (R((T)) → (R ⧸ J)((T))) = J R((T))` for principal `J`.
* `LaurentSeries.mem_map_C_iff`: `f ∈ J R((T))` if and only if every coefficient of `f` is in `J`.
-/

@[expose] public section

noncomputable section

namespace AdicCompletion

variable {R : Type*} [CommRing R]

/-- For a finitely generated ideal `I`, the kernel of `AdicCompletion I R → R ⧸ I ^ n` is the
ideal generated by the image of `I ^ n`. -/
theorem ker_evalₐ_eq_map_pow (I : Ideal R) (hI : I.FG) (n : ℕ) :
    RingHom.ker (evalₐ I n).toRingHom = (I ^ n).map (algebraMap R (AdicCompletion I R)) := by
  ext x
  trans x ∈ (eval I R n).ker
  · have heq : I ^ n * ⊤ = I ^ n := by simp
    have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq heq)) := by
      simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
        using Ideal.map_mk_eq_bot_of_le (le_of_eq heq.symm)
    simpa [← factor_eval_eq_evalₐ] using map_eq_zero_iff _ hinj
  · simp [← pow_smul_top_eq_ker_eval hI]

/-- The evaluations `AdicCompletion I R → R ⧸ I ^ n` are compatible with the reductions
`R ⧸ I ^ n → R ⧸ I ^ m` for `m ≤ n`. -/
theorem factor_evalₐ (I : Ideal R) {m n : ℕ} (hmn : m ≤ n) (x : AdicCompletion I R) :
    Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn) (evalₐ I n x) = evalₐ I m x := by
  obtain ⟨a, rfl⟩ := mk_surjective I R x
  rw [evalₐ_mk, evalₐ_mk, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
  have h := SModEq.sub_mem.mp (a.property hmn)
  rw [smul_eq_mul, Ideal.mul_top] at h
  simpa only [neg_sub] using neg_mem h

end AdicCompletion

namespace LaurentSeries

variable {R : Type*} [CommRing R]

/-- For a principal ideal `J`, the kernel of coefficientwise reduction modulo `J` is the ideal of
`R((T))` generated by `J`. -/
theorem ker_mapRingHom_mk (J : Ideal R) [J.IsPrincipal] :
    RingHom.ker (mapRingHom (Ideal.Quotient.mk J)) =
      J.map (HahnSeries.C : R →+* LaurentSeries R) := by
  obtain ⟨a, rfl⟩ := Submodule.IsPrincipal.principal J
  rw [Ideal.submodule_span_eq, Ideal.map_span, Set.image_singleton]
  exact ker_principalReduction a

/-- For a principal ideal `J`, a Laurent series lies in the ideal generated by `J` if and only if
each of its coefficients lies in `J`. -/
theorem mem_map_C_iff (J : Ideal R) [J.IsPrincipal] (f : LaurentSeries R) :
    f ∈ J.map (HahnSeries.C : R →+* LaurentSeries R) ↔ ∀ n, f.coeff n ∈ J := by
  rw [← ker_mapRingHom_mk, RingHom.mem_ker, HahnSeries.ext_iff, funext_iff]
  simp only [mapRingHom_coeff, HahnSeries.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]

end LaurentSeries
