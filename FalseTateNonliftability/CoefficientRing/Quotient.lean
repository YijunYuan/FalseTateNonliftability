module

public import FalseTateNonliftability.LaurentSeries.PrincipalQuotient
public import Mathlib.RingTheory.AdicCompletion.Completeness

/-!
# Quotients of the completed Laurent coefficient ring

For an arbitrary commutative ring `R`, the completion of `R((T))` at
the constant series `a` has quotient modulo `a ^ r` canonically isomorphic
to `(R / (a ^ r))((T))`. The ring is the canonical `AdicCompletion`;
no separatedness or domain assumption is used, and `r = 0` is included.

This is blueprint lemma `nl:completed-laurent-quotient`.
-/

@[expose] public section

noncomputable section

namespace AdicCompletion

variable {S : Type*} [CommRing S]

/-- The ring kernel of arbitrary adic evaluation, obtained from the
canonical finitely generated module-kernel theorem. -/
theorem ker_evalₐ_eq_map_pow (I : Ideal S) (hI : I.FG) (r : ℕ) :
    RingHom.ker (evalₐ I r).toRingHom =
      (I ^ r).map (algebraMap S (AdicCompletion I S)) := by
  ext x
  trans x ∈ (eval I S r).ker
  · have heq : I ^ r * ⊤ = I ^ r := by simp
    have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq heq)) := by
      simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
        using Ideal.map_mk_eq_bot_of_le (le_of_eq heq.symm)
    simpa [← factor_eval_eq_evalₐ] using map_eq_zero_iff _ hinj
  · simp [← pow_smul_top_eq_ker_eval hI]

end AdicCompletion

namespace LaurentSeries

variable {R : Type*} [CommRing R]

/-- The actual completion of Laurent series at the ideal of the constant `a`. -/
abbrev PrincipalCompletion (a : R) :=
  AdicCompletion (Ideal.span {(HahnSeries.C a : LaurentSeries R)}) (LaurentSeries R)

/-- Powers of a principal constant ideal are generated by the corresponding
constant power, including the zeroth power. -/
theorem span_C_pow (a : R) (r : ℕ) :
    (Ideal.span {(HahnSeries.C a : LaurentSeries R)}) ^ r =
      Ideal.span {HahnSeries.C (a ^ r)} := by
  rw [Ideal.span_singleton_pow, map_pow]

/-- Canonical evaluation of the completed Laurent ring followed by
coefficient reduction modulo `a ^ r`. -/
def completedPrincipalReduction (a : R) (r : ℕ) :
    PrincipalCompletion a →+* LaurentSeries (R ⧸ Ideal.span {a ^ r}) :=
  ((principalQuotientEquiv (a ^ r)).toRingHom.comp
    (Ideal.quotEquivOfEq (span_C_pow a r)).toRingHom).comp
      (AdicCompletion.evalₐ (Ideal.span {HahnSeries.C a}) r).toRingHom

/-- Every Laurent series modulo `a ^ r` is the evaluation of an element
of the canonical completion. -/
theorem completedPrincipalReduction_surjective (a : R) (r : ℕ) :
    Function.Surjective (completedPrincipalReduction a r) :=
  (principalQuotientEquiv (a ^ r)).surjective.comp
    ((Ideal.quotEquivOfEq (span_C_pow a r)).surjective.comp
      (AdicCompletion.surjective_evalₐ _ r))

/-- The completed reduction agrees with ordinary coefficient reduction on
the canonical image of every Laurent series. -/
@[simp]
theorem completedPrincipalReduction_algebraMap (a : R) (r : ℕ) (f : LaurentSeries R) :
    completedPrincipalReduction a r
      (algebraMap (LaurentSeries R) (PrincipalCompletion a) f) =
        principalReduction (a ^ r) f := by
  change principalQuotientEquiv (a ^ r)
    (Ideal.quotEquivOfEq (span_C_pow a r)
      (AdicCompletion.evalₐ (Ideal.span {HahnSeries.C a}) r
        (AdicCompletion.of _ _ f))) = _
  rw [AdicCompletion.evalₐ_of, Ideal.quotEquivOfEq_mk, principalQuotientEquiv_mk]

@[simp]
theorem completedPrincipalReduction_algebraMap_coeff
    (a : R) (r : ℕ) (f : LaurentSeries R) (n : ℤ) :
    (completedPrincipalReduction a r
      (algebraMap (LaurentSeries R) (PrincipalCompletion a) f)).coeff n =
        Ideal.Quotient.mk (Ideal.span {a ^ r}) (f.coeff n) := by
  rw [completedPrincipalReduction_algebraMap, principalReduction_coeff]

/-- The actual kernel is generated by the `r`-th power of the image of `a`.
Only finite generation of the principal ideal is used. -/
theorem ker_completedPrincipalReduction (a : R) (r : ℕ) :
    RingHom.ker (completedPrincipalReduction a r) =
      Ideal.span {(algebraMap (LaurentSeries R) (PrincipalCompletion a)
        (HahnSeries.C a)) ^ r} := by
  rw [completedPrincipalReduction, RingHom.ker_comp_of_injective _
    ((principalQuotientEquiv (a ^ r)).injective.comp
      (Ideal.quotEquivOfEq (span_C_pow a r)).injective)]
  rw [AdicCompletion.ker_evalₐ_eq_map_pow _ (Submodule.fg_span_singleton _) r,
    Ideal.map_pow, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_pow]

/-- The canonical quotient of the completed Laurent ring modulo the
`r`-th power of its distinguished constant. -/
def completedPrincipalQuotientEquiv (a : R) (r : ℕ) :
    PrincipalCompletion a ⧸
      Ideal.span {(algebraMap (LaurentSeries R) (PrincipalCompletion a)
        (HahnSeries.C a)) ^ r} ≃+* LaurentSeries (R ⧸ Ideal.span {a ^ r}) :=
  (Ideal.quotEquivOfEq (ker_completedPrincipalReduction a r).symm).trans
    (RingHom.quotientKerEquivOfSurjective (completedPrincipalReduction_surjective a r))

@[simp]
theorem completedPrincipalQuotientEquiv_mk
    (a : R) (r : ℕ) (x : PrincipalCompletion a) :
    completedPrincipalQuotientEquiv a r (Ideal.Quotient.mk _ x) =
      completedPrincipalReduction a r x := rfl

@[simp]
theorem completedPrincipalQuotientEquiv_mk_algebraMap_coeff
    (a : R) (r : ℕ) (f : LaurentSeries R) (n : ℤ) :
    (completedPrincipalQuotientEquiv a r (Ideal.Quotient.mk _
      (algebraMap (LaurentSeries R) (PrincipalCompletion a) f))).coeff n =
        Ideal.Quotient.mk (Ideal.span {a ^ r}) (f.coeff n) := by
  rw [completedPrincipalQuotientEquiv_mk, completedPrincipalReduction_algebraMap_coeff]

end LaurentSeries
