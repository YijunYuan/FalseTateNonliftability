module

public import Mathlib.RingTheory.AdicCompletion.Completeness

/-!
# Kernels of the evaluations of an adic completion

Let `R` be a commutative ring, `I` an ideal of `R` and `R̂ = AdicCompletion I R` the `I`-adic
completion of `R`. For every `n` there is the evaluation `R̂ → R ⧸ I ^ n`. These evaluations are
compatible with the reductions `R ⧸ I ^ n → R ⧸ I ^ m` for `m ≤ n`, and if `I` is finitely
generated, the kernel of `R̂ → R ⧸ I ^ n` is the ideal `I ^ n R̂` of `R̂` generated by `I ^ n`.

This file is a candidate for upstreaming to Mathlib (`Mathlib.RingTheory.AdicCompletion`).

## Main results

* `AdicCompletion.ker_evalₐ_eq_map_pow`: for finitely generated `I`, the kernel of
  `R̂ → R ⧸ I ^ n` is `I ^ n R̂`.
* `AdicCompletion.factor_evalₐ`: for `m ≤ n`, the evaluation `R̂ → R ⧸ I ^ m` factors through
  `R̂ → R ⧸ I ^ n`.

## References

* Y. Yuan, *Non-liftability of the field of norms of the p-adic false Tate curve extension*,
  Definition 1.1 and §1.4 (the quotients `A ⧸ ϖ_F ^ (r + 1) A` of the completion `A`).
-/

@[expose] public section

noncomputable section

namespace AdicCompletion

variable {R : Type*} [CommRing R]

/-- For a finitely generated ideal `I`, the kernel of the evaluation `R̂ → R ⧸ I ^ n` of the
`I`-adic completion `R̂` of `R` is the ideal `I ^ n R̂` generated by `I ^ n`. -/
theorem ker_evalₐ_eq_map_pow (I : Ideal R) (hI : I.FG) (n : ℕ) :
    RingHom.ker (evalₐ I n).toRingHom = (I ^ n).map (algebraMap R (AdicCompletion I R)) := by
  ext x
  trans x ∈ (eval I R n).ker
  · have heq : I ^ n * ⊤ = I ^ n := by simp
    have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq heq)) := by
      simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker]
        using Ideal.map_mk_eq_bot_of_le (le_of_eq heq.symm)
    simpa [← factor_eval_eq_evalₐ] using map_eq_zero_iff _ hinj
  · simp [← pow_smul_top_eq_ker_eval hI]

/-- For `m ≤ n`, the evaluation `R̂ → R ⧸ I ^ m` of the `I`-adic completion `R̂` of `R` is the
evaluation `R̂ → R ⧸ I ^ n` followed by the reduction `R ⧸ I ^ n → R ⧸ I ^ m`. -/
theorem factor_evalₐ (I : Ideal R) {m n : ℕ} (hmn : m ≤ n) (x : AdicCompletion I R) :
    Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn) (evalₐ I n x) = evalₐ I m x := by
  obtain ⟨a, rfl⟩ := mk_surjective I R x
  rw [evalₐ_mk, evalₐ_mk, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
  have h := SModEq.sub_mem.mp (a.property hmn)
  rw [smul_eq_mul, Ideal.mul_top] at h
  simpa only [neg_sub] using neg_mem h

end AdicCompletion
