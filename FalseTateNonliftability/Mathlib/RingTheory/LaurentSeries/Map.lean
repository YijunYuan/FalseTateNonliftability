public import FalseTateNonliftability.Mathlib.RingTheory.LaurentSeries.Topology
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Coefficient maps of Laurent series

A homomorphism `φ : R →+* S` of commutative rings induces the ring homomorphism
`mapRingHom φ : R((T)) →+* S((T))` applying `φ` to the coefficients. It does not decrease the
order, it is continuous for the `T`-adic topologies, it commutes with the derivative, and it is
surjective if `φ` is. For a principal ideal `J = (a)` of `R`, the kernel of the reduction
`R((T)) → (R ⧸ J)((T))` is the ideal generated by `J`, so that `R((T)) ⧸ J R((T)) ≃ (R ⧸ J)((T))`;
no hypothesis on `R` is needed.

## Main definitions

* `LaurentSeries.mapRingHom φ`: the coefficient map `R((T)) →+* S((T))`.
* `LaurentSeries.principalReduction a`: the reduction `R((T)) → (R ⧸ (a))((T))`.
* `LaurentSeries.principalQuotientEquiv a`: the isomorphism `R((T)) ⧸ (a) ≃+* (R ⧸ (a))((T))`.

## Main results

* `LaurentSeries.mapRingHom_surjective`: `mapRingHom φ` is surjective if `φ` is.
* `LaurentSeries.orderTop_le_mapRingHom`, `LaurentSeries.orderTop_mapRingHom_of_injective`,
  `LaurentSeries.orderTop_mapRingHom_eq_of_ker_eq`: coefficient maps and the order.
* `LaurentSeries.continuous_mapRingHom`: continuity for the `T`-adic topologies.
* `LaurentSeries.mapRingHom_derivative`: compatibility with the derivative.
* `LaurentSeries.ker_principalReduction`, `LaurentSeries.ker_mapRingHom_mk`,
  `LaurentSeries.mem_map_C_iff`: the kernel of the reduction modulo a principal ideal.
-/

@[expose] public section

namespace LaurentSeries

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The ring homomorphism `R((T)) →+* S((T))` applying `f` to the coefficients. -/
def mapRingHom (f : R →+* S) : LaurentSeries R →+* LaurentSeries S where
  toFun x := x.map f
  map_one' := HahnSeries.map_one f.toMonoidWithZeroHom
  map_mul' _ _ := HahnSeries.map_mul f.toNonUnitalRingHom
  map_zero' := HahnSeries.map_zero f.toZeroHom
  map_add' _ _ := HahnSeries.map_add f.toAddMonoidHom

@[simp]
theorem mapRingHom_coeff (f : R →+* S) (x : LaurentSeries R) (n : ℤ) :
    (mapRingHom f x).coeff n = f (x.coeff n) := rfl

@[simp]
theorem mapRingHom_C (f : R →+* S) (a : R) :
    mapRingHom f (HahnSeries.C a) = HahnSeries.C (f a) :=
  HahnSeries.map_C a f

/-- If `f` is surjective, then so is `mapRingHom f`. -/
theorem mapRingHom_surjective (f : R →+* S) (hf : Function.Surjective f) :
    Function.Surjective (mapRingHom f) := by
  classical
  intro x
  let g : S → R := fun s ↦ if s = 0 then 0 else (hf s).choose
  have hg (s : S) : f (g s) = s := by
    by_cases hs : s = 0
    · simp [g, hs]
    · simpa [g, hs] using (hf s).choose_spec
  have hg0 : g 0 = 0 := by simp [g]
  let y : LaurentSeries R :=
    ⟨fun n ↦ g (x.coeff n), x.isPWO_support.mono <| by
      intro n hn
      exact fun h ↦ hn (by simpa [h] using hg0)⟩
  refine ⟨y, ?_⟩
  ext n
  exact hg (x.coeff n)

/-- A Laurent series lies in the ideal generated by the constant `a` if and only if each of its
coefficients lies in `(a)`. -/
theorem mem_span_C_iff (a : R) (x : LaurentSeries R) :
    x ∈ Ideal.span {HahnSeries.C a} ↔ ∀ n, x.coeff n ∈ Ideal.span {a} := by
  classical
  constructor
  · intro hx n
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp hx
    apply Ideal.mem_span_singleton.mpr
    exact ⟨y.coeff n, by simp⟩
  · intro hx
    have hdiv (n : ℤ) : ∃ b : R, x.coeff n = a * b :=
      Ideal.mem_span_singleton.mp (hx n)
    choose b hb using hdiv
    let c : ℤ → R := fun n ↦ if x.coeff n = 0 then 0 else b n
    have hc (n : ℤ) : x.coeff n = a * c n := by
      by_cases hn : x.coeff n = 0
      · simp [c, hn]
      · simpa [c, hn] using hb n
    let y : LaurentSeries R :=
      ⟨c, x.isPWO_support.mono <| by
        intro n hn
        exact fun h ↦ hn (by simp [c, h])⟩
    apply Ideal.mem_span_singleton.mpr
    refine ⟨y, ?_⟩
    ext n
    simpa [HahnSeries.C_mul_eq_smul, y] using hc n

/-- The reduction `R((T)) → (R ⧸ (a))((T))` of the coefficients modulo `a`. -/
def principalReduction (a : R) :
    LaurentSeries R →+* LaurentSeries (R ⧸ Ideal.span {a}) :=
  mapRingHom (Ideal.Quotient.mk (Ideal.span {a}))

@[simp]
theorem principalReduction_coeff (a : R) (x : LaurentSeries R) (n : ℤ) :
    (principalReduction a x).coeff n = Ideal.Quotient.mk (Ideal.span {a}) (x.coeff n) :=
  rfl

/-- Every Laurent series over `R ⧸ (a)` lifts to `R((T))`. -/
theorem principalReduction_surjective (a : R) :
    Function.Surjective (principalReduction a) :=
  mapRingHom_surjective _ Ideal.Quotient.mk_surjective

/-- The kernel of the reduction modulo `a` is the ideal generated by the constant `a`. -/
theorem ker_principalReduction (a : R) :
    RingHom.ker (principalReduction a) = Ideal.span {HahnSeries.C a} := by
  ext x
  rw [RingHom.mem_ker, HahnSeries.ext_iff, funext_iff, mem_span_C_iff]
  simp only [principalReduction_coeff, HahnSeries.coeff_zero,
    Ideal.Quotient.eq_zero_iff_mem]

/-- The isomorphism `R((T)) ⧸ (a) ≃+* (R ⧸ (a))((T))`. -/
def principalQuotientEquiv (a : R) :
    LaurentSeries R ⧸ Ideal.span {(HahnSeries.C a : LaurentSeries R)} ≃+*
      LaurentSeries (R ⧸ Ideal.span {a}) :=
  (Ideal.quotEquivOfEq (ker_principalReduction a).symm).trans
    (RingHom.quotientKerEquivOfSurjective (principalReduction_surjective a))

@[simp]
theorem principalQuotientEquiv_mk (a : R) (x : LaurentSeries R) :
    principalQuotientEquiv a (Ideal.Quotient.mk _ x) = principalReduction a x :=
  rfl

@[simp]
theorem principalQuotientEquiv_mk_coeff (a : R) (x : LaurentSeries R) (n : ℤ) :
    (principalQuotientEquiv a (Ideal.Quotient.mk _ x)).coeff n =
      Ideal.Quotient.mk (Ideal.span {a}) (x.coeff n) :=
  rfl

/-- For a principal ideal `J`, the kernel of coefficientwise reduction modulo `J` is the ideal of
`R((T))` generated by `J`. -/
theorem ker_mapRingHom_mk (J : Ideal R) [J.IsPrincipal] :
    RingHom.ker (mapRingHom (Ideal.Quotient.mk J)) =
      J.map (HahnSeries.C : R →+* LaurentSeries R) := by
  obtain ⟨a, rfl⟩ := Submodule.IsPrincipal.principal J
  rw [Ideal.submodule_span_eq, Ideal.map_span, Set.image_singleton]
  exact ker_principalReduction a

/-- For a principal ideal `J`, a Laurent series lies in the ideal generated by `J` if and only if
each of its coefficients lies in `J`. -/
theorem mem_map_C_iff (J : Ideal R) [J.IsPrincipal] (f : LaurentSeries R) :
    f ∈ J.map (HahnSeries.C : R →+* LaurentSeries R) ↔ ∀ n, f.coeff n ∈ J := by
  rw [← ker_mapRingHom_mk, RingHom.mem_ker, HahnSeries.ext_iff, funext_iff]
  simp only [mapRingHom_coeff, HahnSeries.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]

section Maps

variable {T : Type*} [CommRing T]

/-- Coefficient maps compose. -/
theorem mapRingHom_comp (ψ : S →+* T) (φ : R →+* S) :
    mapRingHom (ψ.comp φ) = (mapRingHom ψ).comp (mapRingHom φ) :=
  RingHom.ext fun _ ↦ rfl

@[simp]
theorem mapRingHom_single (ψ : R →+* S) (j : ℤ) (b : R) :
    mapRingHom ψ (HahnSeries.single j b) = HahnSeries.single j (ψ b) :=
  HahnSeries.map_single ψ.toZeroHom

/-- On power series, the coefficient map of Laurent series is the coefficient map of power
series. -/
theorem mapRingHom_ofPowerSeries (φ : R →+* S) (P : PowerSeries R) :
    mapRingHom φ (HahnSeries.ofPowerSeries ℤ R P) =
      HahnSeries.ofPowerSeries ℤ S (PowerSeries.map φ P) := by
  ext j
  simp only [mapRingHom_coeff, PowerSeries.coeff_coe, PowerSeries.coeff_map]
  split_ifs <;> simp only [map_zero]

/-- Coefficient maps do not decrease the order. -/
theorem orderTop_le_mapRingHom (ψ : R →+* S) (f : LaurentSeries R) :
    f.orderTop ≤ (mapRingHom ψ f).orderTop := by
  apply HahnSeries.le_orderTop_iff_forall.mpr
  intro j hj
  rw [mapRingHom_coeff, HahnSeries.coeff_eq_zero_of_lt_orderTop hj, map_zero]

/-- Injective coefficient maps preserve the order. -/
theorem orderTop_mapRingHom_of_injective (ψ : R →+* S) (hψ : Function.Injective ψ)
    (f : LaurentSeries R) : (mapRingHom ψ f).orderTop = f.orderTop := by
  apply le_antisymm ?_ (orderTop_le_mapRingHom ψ f)
  apply HahnSeries.le_orderTop_iff_forall.mpr
  intro j hj
  apply hψ
  rw [map_zero]
  exact HahnSeries.coeff_eq_zero_of_lt_orderTop hj

private theorem orderTop_mapRingHom_le_of_ker_le (φ : R →+* S) (ψ : R →+* T)
    (h : RingHom.ker φ ≤ RingHom.ker ψ) (f : LaurentSeries R) :
    (mapRingHom φ f).orderTop ≤ (mapRingHom ψ f).orderTop := by
  apply HahnSeries.le_orderTop_iff_forall.mpr
  intro j hj
  rw [mapRingHom_coeff, ← RingHom.mem_ker]
  apply h
  rw [RingHom.mem_ker]
  exact HahnSeries.coeff_eq_zero_of_lt_orderTop hj

/-- Two coefficient maps with the same kernel give the same order. -/
theorem orderTop_mapRingHom_eq_of_ker_eq (φ : R →+* S) (ψ : R →+* T)
    (h : RingHom.ker φ = RingHom.ker ψ) (f : LaurentSeries R) :
    (mapRingHom φ f).orderTop = (mapRingHom ψ f).orderTop :=
  le_antisymm (orderTop_mapRingHom_le_of_ker_le φ ψ h.le f)
    (orderTop_mapRingHom_le_of_ker_le ψ φ h.ge f)

/-- If `f = O(T ^ m)`, then `mapRingHom ψ f = O(T ^ m)`. -/
theorem mapRingHom_mem_orderAddSubgroup (ψ : R →+* S) (m : ℤ)
    (f : LaurentSeries R) (hf : f ∈ orderAddSubgroup m) :
    mapRingHom ψ f ∈ orderAddSubgroup m :=
  hf.trans (orderTop_le_mapRingHom ψ f)

/-- Coefficient maps commute with the derivative. -/
theorem mapRingHom_derivative (ψ : R →+* S) (f : LaurentSeries R) :
    mapRingHom ψ (derivative R f) = derivative S (mapRingHom ψ f) := by
  ext j
  simp only [mapRingHom_coeff, coeff_derivative, map_mul, map_intCast]

open scoped LaurentSeries.OrderTopology in
/-- Coefficient maps are continuous for the `T`-adic topologies. -/
theorem continuous_mapRingHom (ψ : R →+* S) : Continuous (mapRingHom ψ) := by
  refine continuous_iff_continuousAt.mpr fun f ↦ ?_
  refine ((orderTopology_hasBasis_nhds f).tendsto_iff
    (orderTopology_hasBasis_nhds (mapRingHom ψ f))).mpr fun m _ ↦ ⟨m, trivial, fun g hg ↦ ?_⟩
  simp only [Set.mem_ofPred_eq] at hg ⊢
  rw [← map_sub]
  exact mapRingHom_mem_orderAddSubgroup ψ m (g - f) hg

end Maps

end

end LaurentSeries
